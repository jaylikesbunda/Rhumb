#!/bin/sh
# Entry point for the AppImage. AppRun runs with the AppDir as $APPDIR, so the
# binary is found relative to this script no matter where the image is mounted.
HERE="$(dirname "$(readlink -f "$0")")"
export PATH="$HERE:${PATH}"
export LD_LIBRARY_PATH="$HERE/lib:${LD_LIBRARY_PATH:-}"
exec "$HERE/usr/bin/rhumb" "$@"
