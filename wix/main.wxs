<?xml version="1.0" encoding="windows-1252"?>
<!--
  WiX v3 source for the Rhumb MSI.

  Built by tools/build_msi.sh, which reads the version out of Cargo.toml and
  hands it to candle as a preprocessor variable. Driving candle and light
  directly keeps the version in step with the manifest without a template
  engine in the way.

  Paths are relative to the repository root, which is where the script runs the
  compiler from. Run it with:

      tools/build_msi.sh

  Note for editors: an XML comment may not contain a double hyphen, and the
  preprocessor substitutes variables inside comments too, so neither appears
  in the prose above.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Product
        Id="*"
        Name="Rhumb"
        UpgradeCode="7C1E1F0A-9C0B-4C7E-9E4A-2C0B4E1D5A31"
        Language="1033"
        Codepage="1252"
        Manufacturer="Rhumb"
        Version="$(var.PkgVersion)">

        <!--
          The package is 64-bit. That is declared with candle's arch switch
          rather than here, because the Template Summary property is what ICE80
          reads and the switch is the only supported way to set it.
        -->
        <Package Id="*"
                 Keywords="Installer"
                 Description="Rhumb, a minimal file explorer with a Markdown preview"
                 InstallerVersion="500"
                 Languages="1033"
                 Compressed="yes"
                 InstallScope="perMachine"
                 SummaryCodepage="1252"
                 Manufacturer="Rhumb"/>

        <!-- A newer build replaces an older one in place; downgrades are refused. -->
        <MajorUpgrade Schedule="afterInstallInitialize"
                      DowngradeErrorMessage="A newer version of Rhumb is already installed."/>
        <MediaTemplate EmbedCab="yes" />

        <!-- Repairs would need the original binaries, so they are not offered. -->
        <Property Id="ARPNOREPAIR" Value="1"/>
        <Property Id="ARPPRODUCTICON" Value="ProductIcon"/>
        <Icon Id="ProductIcon" SourceFile="assets\icon.ico"/>

        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="ProgramFiles64Folder">
                <Directory Id="APPLICATIONFOLDER" Name="Rhumb">
                    <!--
                      Win64 is required on every component: without it a
                      package under ProgramFiles64Folder is validated as
                      32-bit and lands in Program Files (x86) on a 64-bit
                      machine. ICE80 fails the link if this is missing.
                    -->
                    <Component Id="MainExecutable" Guid="*" Win64="yes">
                        <File Id="RhumbExe"
                              Name="rhumb.exe"
                              Source="target\release\rhumb.exe"
                              KeyPath="yes">
                            <Shortcut Id="StartMenuShortcut"
                                      Directory="ApplicationProgramsFolder"
                                      Name="Rhumb"
                                      Description="A minimal file explorer with a Markdown preview"
                                      Advertise="yes"
                                      WorkingDirectory="APPLICATIONFOLDER"/>
                        </File>
                        <!-- Uninstall leaves no empty Start menu folder behind. -->
                        <RemoveFolder Id="RemoveApplicationProgramsFolder"
                                      Directory="ApplicationProgramsFolder"
                                      On="uninstall"/>
                        <RemoveFile Id="RemoveStartMenuShortcut"
                                    Name="Rhumb.lnk"
                                    Directory="ApplicationProgramsFolder"
                                    On="uninstall"/>
                    </Component>
                    <Component Id="Readme" Guid="*" Win64="yes">
                        <File Id="ReadmeMd"
                              Name="README.md"
                              Source="README.md"
                              KeyPath="yes"/>
                    </Component>
                    <Component Id="License" Guid="*" Win64="yes">
                        <File Id="LicenseTxt"
                              Name="LICENSE"
                              Source="LICENSE"
                              KeyPath="yes"/>
                    </Component>
                </Directory>
            </Directory>
            <Directory Id="ProgramMenuFolder">
                <Directory Id="ApplicationProgramsFolder" Name="Rhumb"/>
            </Directory>
        </Directory>

        <Feature Id="MainFeature"
                 Title="Rhumb"
                 Level="1"
                 ConfigurableDirectory="APPLICATIONFOLDER"
                 Display="expand">
            <ComponentRef Id="MainExecutable"/>
            <ComponentRef Id="Readme"/>
            <ComponentRef Id="License"/>
        </Feature>

        <!--
          No WixUI here on purpose. The WixUI library is not part of the WiX
          binaries payload, only of the full installer, so depending on it
          would make the build fail on any machine that has candle and light
          without the complete toolset. With no UIRef the package gets the core
          dialogs, which are enough for one feature and a Start menu shortcut,
          and the licence is installed next to the program. Add a WixUI UIRef
          later if a feature chooser or a welcome page is wanted.
        -->
    </Product>
</Wix>
